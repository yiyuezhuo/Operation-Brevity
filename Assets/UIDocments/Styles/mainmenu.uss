.main-menu-root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgb(20, 26, 16);
    background-image: url("project://database/Assets/Textures/OperationBrevity_Historical.jpg?fileID=2800000&guid=cd4e769a65a24cca982dd9a0400f898d&type=3#OperationBrevity_Historical");
    -unity-background-scale-mode: scale-and-crop;
    padding-left: 24px;
    padding-right: 24px;
}

.main-menu-title {
    font-size: 48px;
    -unity-font-style: bold;
    color: rgb(233, 239, 206);
    background-color: rgba(18, 24, 14, 0.82);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(188, 199, 138, 0.68);
    border-right-color: rgba(188, 199, 138, 0.68);
    border-top-color: rgba(188, 199, 138, 0.68);
    border-bottom-color: rgba(188, 199, 138, 0.68);
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 8px;
    padding-bottom: 8px;
    margin-bottom: 32px;
}

.main-menu-buttons {
    width: 280px;
    background-color: rgba(30, 37, 25, 0.96);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(188, 199, 138, 0.55);
    border-right-color: rgba(188, 199, 138, 0.55);
    border-top-color: rgba(188, 199, 138, 0.55);
    border-bottom-color: rgba(188, 199, 138, 0.55);
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 8px;
    padding-bottom: 4px;
}

.main-menu-button {
    height: 44px;
    margin-bottom: 12px;
    font-size: 18px;
}

    -unity-background-image-tint-color: rgb(220, 230, 183);
}

.unity-base-dropdown .unity-scroll-view__horizontal-scroller .unity-scroller__low-button .unity-text-element,
.unity-base-dropdown .unity-scroll-view__horizontal-scroller .unity-scroller__high-button .unity-text-element,
.unity-base-dropdown .unity-scroller--horizontal .unity-scroller__low-button .unity-text-element,
.unity-base-dropdown .unity-scroller--horizontal .unity-scroller__high-button .unity-text-element,
.unity-base-dropdown .unity-scroll-view__horizontal-scroller .unity-repeat-button.unity-scroller__low-button,
.unity-base-dropdown .unity-scroll-view__horizontal-scroller .unity-repeat-button.unity-scroller__high-button,
.unity-base-dropdown .unity-scroller--horizontal .unity-repeat-button.unity-scroller__low-button,
.unity-base-dropdown .unity-scroller--horizontal .unity-repeat-button.unity-scroller__high-button {
    color: rgb(232, 239, 198);
    -unity-background-image-tint-color: rgb(232, 239, 198);
    opacity: 1;
}

.unity-base-dropdown .unity-scroll-view__horizontal-scroller .unity-scroller__low-button:hover,
.unity-base-dropdown .unity-scroll-view__horizontal-scroller .unity-scroller__high-button:hover,
.unity-base-dropdown .unity-scroller--horizontal .unity-scroller__low-button:hover,
.unity-base-dropdown .unity-scroller--horizontal .unity-scroller__high-button:hover {
    background-color: rgba(62, 75, 43, 0.95);
}

.top-bar-select-cell {
    width: 122px;
}

.top-bar-select-map {
    width: 108px;
}

.top-bar-select-side {
    width: 74px;
}

.top-bar-button {
    color: rgb(212, 222, 171);
    background-color: rgba(45, 54, 34, 0.95);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(177, 191, 126, 0.46);
    border-right-color: rgba(177, 191, 126, 0.46);
    border-top-color: rgba(177, 191, 126, 0.46);
    border-bottom-color: rgba(177, 191, 126, 0.46);
}

.top-bar-button .unity-text-element {
    color: rgb(212, 222, 171);
}

.top-bar-button:hover,
.top-bar-button:enabled:hover {
    color: rgb(236, 242, 205);
    background-color: rgba(34, 42, 26, 0.98);
}

.top-bar-button:hover .unity-text-element,
.top-bar-button:enabled:hover .unity-text-element {
    color: rgb(236, 242, 205);
}

.top-bar-button-primary {
    -unity-font-style: bold;
}

.top-bar-button-warn {
    color: rgb(255, 230, 157);
    background-color: rgba(102, 82, 40, 0.92);
}

.top-bar-button-danger {
    color: rgb(255, 208, 190);
    background-color: rgba(98, 52, 46, 0.92);
}

.unity-base-field__input {
    padding-top: 1px;
    padding-bottom: 1px;
}

.unity-label {
    padding-top: 1px;
    padding-bottom: 1px;
    margin-top: 1px;
    margin-bottom: 1px;
}

.unity-button {
    padding-top: 1px;
    padding-bottom: 1px;
}

.unity-button.large {
    padding-bottom: 6px;
    padding-top: 6px;
}

.title {
    padding-left: 1px;
    padding-top: 0;
    margin-top: 0;
    margin-left: 0;
    padding-right: 1px;
    margin-right: 0;
    padding-bottom: 2px;
    background-color: rgb(200, 200, 200);
    margin-bottom: 1px;
}

.unity-tab-view__content-viewport {
    flex-shrink: 0;
}

.unity-multi-column-header {
    height: 23px;
    min-height: 23px;
}

.unity-foldout__toggle {
    height: 23px;
    min-height: 23px;
}

.unity.collection-view:focus:enabled.unity-collection-view__item--selected {
    color: rgb(0, 0, 0);
    background-color: rgba(197, 245, 255, 0);
}

.unity-collection-view__item--selected:hover:enabled {
    color: rgb(0, 0, 0);
    background-color: rgba(221, 244, 250, 0.39);
}

.unity-collection-view:focus:enabled.unity-collection-view__item--selected {
    color: rgb(0, 0, 0);
    background-color: rgba(221, 244, 250, 0.39);
}

.unity-collection-view:focus:enabled .unity-collection-view__item--selected {
    background-color: rgba(221, 244, 250, 0.39);
    color: rgb(0, 0, 0);
}

.panel {
    background-color: rgb(240, 240, 240);
    flex-grow: 1;
}

.size50 .unity-label {
    min-width: 50px;
}

.panel-dialog {
    background-color: rgb(255, 255, 255);
    flex-grow: 0;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-top-left-radius: 1px;
    border-top-right-radius: 1px;
    border-bottom-right-radius: 1px;
    border-bottom-left-radius: 1px;
    width: 400px;
    height: 400px;
}

.unity-base-dropdown__label {
    margin-left: 1px;
    margin-bottom: 1px;
    margin-right: 1px;
    margin-top: 1px;
    padding-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
}

.unity-text-element.unity-label.unity-base-dropdown__label {
    margin-top: 1px;
    margin-right: 1px;
    margin-bottom: 1px;
    margin-left: 1px;
    padding-top: 1px;
    padding-right: 1px;
    padding-bottom: 1px;
    padding-left: 1px;
}

.unity-toggle__checkmark {
    width: 18px;
    height: 18px;
}

.unity-enum-field__text {
    padding-right: 0;
    margin-right: 5px;
}

.unity-base-popup-field__text {
    margin-right: 5px;
}

.unity-button.verylarge {
    padding-top: 6px;
    padding-bottom: 6px;
    font-size: 20px;
    margin-bottom: 4px;
    margin-top: 4px;
}

.unity-base-field__input {
    padding-left: 2px;
    padding-right: 2px;
}

.unity-float-field {
    min-width: 35px;
}

.border-box {
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    margin-top: 1px;
    margin-right: 1px;
}

.battery-arc-indicator {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    width: 30px;
    height: 100px;
}

.fix-height-float-field-container .unity-float-field {
    height: 20px;
}

.unity-tab-view.grow .unity-tab__content-container {
    flex-grow: 1;
}

.unity-tab-view.grow .unity-tab-view__content-container {
    flex-grow: 1;
}

.unity-tab-view.grow .unity-tab {
    flex-grow: 1;
}

.localized-enum-field {
    margin-bottom: 0;
    margin-top: 0;
}

.unity-toggle__checkmark.unity-foldout__checkmark {
    margin-right: 0;
    margin-left: 0;
}

.long-dropdown {
    width: 150px;
}

.unity-radio-button__checkmark-background {
    width: 18px;
    height: 18px;
    padding-top: 3px;
    padding-bottom: 0;
    padding-left: 1px;
    padding-right: 1px;
}

.unity-radio-button__checkmark {
    width: 9px;
    height: 9px;
}

.panel-major-dialog {
    background-color: rgb(255, 255, 255);
    flex-grow: 0;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-top-left-radius: 1px;
    border-top-right-radius: 1px;
    border-bottom-right-radius: 1px;
    border-bottom-left-radius: 1px;
    width: 900px;
    height: 600px;
    max-height: 600px;
}

.log-label {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    font-size: 10px;
    white-space: normal;
}

.unity-foldout__toggle {
    height: 24px;
    max-height: 24px;
    min-height: 24px;
}

.x-button {
    padding-left: 5px;
    padding-right: 5px;
}
.info-panel {
    width: 260px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 6px;
    padding-bottom: 8px;
    background-color: rgba(42, 50, 34, 0.94);
    border-left-width: 1px;
    border-left-color: rgba(178, 190, 126, 0.65);
}

.info-panel-section {
    background-color: rgba(24, 30, 21, 0.88);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(162, 176, 112, 0.45);
    border-right-color: rgba(162, 176, 112, 0.45);
    border-top-color: rgba(162, 176, 112, 0.45);
    border-bottom-color: rgba(162, 176, 112, 0.45);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    margin-top: 3px;
    margin-bottom: 3px;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 3px;
    padding-bottom: 3px;
}

.info-panel-time-section {
    margin-top: 0;
}

.info-panel-inline-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    column-gap: 4px;
}

.info-panel-time-label {
    -unity-font-style: bold;
    color: rgb(208, 219, 154);
}

.info-panel-cell-label {
    white-space: normal;
    color: rgba(201, 210, 168, 0.92);
}

.info-panel-stack {
    flex-direction: row;
    flex-wrap: wrap;
    background-color: rgba(53, 63, 41, 0.7);
    border-bottom-width: 1px;
    border-top-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-left-color: rgba(175, 188, 127, 0.52);
    border-right-color: rgba(175, 188, 127, 0.52);
    border-top-color: rgba(175, 188, 127, 0.52);
    border-bottom-color: rgba(175, 188, 127, 0.52);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    min-height: 54px;
    padding-left: 2px;
    padding-right: 2px;
    padding-top: 2px;
    padding-bottom: 2px;
    margin-top: 4px;
    margin-bottom: 4px;
}

.info-panel-stack > * {
    margin-left: 2px;
    margin-right: 2px;
    margin-top: 2px;
    margin-bottom: 2px;
}

.info-panel-oob-list {
    max-height: 94px;
    min-height: 42px;
    margin-bottom: 4px;
}

.info-panel-unit-summary {
    flex-direction: row;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(184, 197, 136, 0.58);
    border-right-color: rgba(184, 197, 136, 0.58);
    border-top-color: rgba(184, 197, 136, 0.58);
    border-bottom-color: rgba(184, 197, 136, 0.58);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    background-color: rgba(38, 46, 30, 0.86);
    padding-left: 2px;
    padding-right: 2px;
    padding-top: 2px;
    padding-bottom: 2px;
    margin-bottom: 4px;
}

.info-panel-unit-icon-slot {
    margin-right: 4px;
}

.info-panel-progress {
    margin-top: 1px;
    margin-bottom: 1px;
}

.info-panel-action-button {
    color: rgb(214, 224, 173);
    background-color: rgba(39, 47, 31, 0.96);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(168, 181, 120, 0.5);
    border-right-color: rgba(168, 181, 120, 0.5);
    border-top-color: rgba(168, 181, 120, 0.5);
    border-bottom-color: rgba(168, 181, 120, 0.5);
    margin-top: 2px;
    margin-bottom: 2px;
}

.info-panel-primary-button {
    -unity-font-style: bold;
}

.info-panel-mission-box {
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(180, 194, 132, 0.56);
    border-right-color: rgba(180, 194, 132, 0.56);
    border-top-color: rgba(180, 194, 132, 0.56);
    border-bottom-color: rgba(180, 194, 132, 0.56);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    background-color: rgba(44, 54, 33, 0.82);
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 3px;
    padding-bottom: 3px;
    margin-top: 2px;
}

.info-panel-mission-label {
    -unity-font-style: bold;
    color: rgb(215, 225, 174);
    white-space: normal;
}

.info-panel-depth-field {
    min-width: 60px;
}
.top-bar {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 4px;
    row-gap: 3px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 4px;
    padding-bottom: 4px;
    background-color: rgba(30, 37, 25, 0.96);
    border-bottom-width: 1px;
    border-bottom-color: rgba(188, 199, 138, 0.55);
}

.top-bar-group {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 3px;
    row-gap: 2px;
}

.top-bar-controls-group {
    background-color: rgba(46, 55, 34, 0.66);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(177, 191, 126, 0.44);
    border-right-color: rgba(177, 191, 126, 0.44);
    border-top-color: rgba(177, 191, 126, 0.44);
    border-bottom-color: rgba(177, 191, 126, 0.44);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 2px;
    padding-bottom: 2px;
}

.top-bar-separator {
    width: 1px;
    min-height: 20px;
    background-color: rgba(186, 196, 137, 0.48);
    margin-left: 2px;
    margin-right: 2px;
}

.top-bar-field-label {
    -unity-font-style: bold;
    color: rgb(203, 215, 150);
    margin-right: 1px;
}

.top-bar-select {
    min-width: 72px;
}

.top-bar-select-cell {
    width: 122px;
}

.top-bar-select-map {
    width: 108px;
}

.top-bar-select-side {
    width: 74px;
}

.top-bar-button {
    color: rgb(212, 222, 171);
    background-color: rgba(45, 54, 34, 0.95);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(177, 191, 126, 0.46);
    border-right-color: rgba(177, 191, 126, 0.46);
    border-top-color: rgba(177, 191, 126, 0.46);
    border-bottom-color: rgba(177, 191, 126, 0.46);
}

.top-bar-button-primary {
    -unity-font-style: bold;
}

.top-bar-button-warn {
    color: rgb(255, 230, 157);
    background-color: rgba(102, 82, 40, 0.92);
}

.top-bar-button-danger {
    color: rgb(255, 208, 190);
    background-color: rgba(98, 52, 46, 0.92);
}
